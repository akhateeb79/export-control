{
  "name": "workspace",
  "version": "1.0.0",
  "description": "Multi-tenant SaaS supporting export control decisions for Gulf re-export businesses.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "api": "node api/server.js",
    "client:build": "cd client && npx vite build",
    "client:dev": "cd client && npx vite --host 0.0.0.0 --port 5000",
    "ingest": "node jobs/ingest/index.js",
    "test:api": "node --env-file .env --test api/tests/*.test.js",
    "test:ingest": "node jobs/ingest/test/run-integration.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report tests/e2e/results/html",
    "db:seed-demo": "node --env-file .env -e \"require('./scripts/seed-demo.js')\"",
    "db:import-uae-list": "node --env-file .env scripts/import-uae-control-list.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akhateeb79/export-control.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/akhateeb79/export-control/issues"
  },
  "homepage": "https://github.com/akhateeb79/export-control#readme",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.12.2",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.6",
    "openai": "^7.15.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "vite": "^8.2.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
